nextflow_pipeline {

    name "Full Integration Tests"
    script "main.nf"

    test("Should pass.") {
        tag "pass"

        when {
            params {
                input = "$baseDir/tests/data/samplesheet.csv"
                outdir = "$outputDir"

                kraken2_db = "$baseDir/tests/data/test_db"
                ganon_db = "$baseDir/tests/data/ganon_test"
                ganon_db_prefix = "ganon_test"
                lexicmap_db = "$baseDir/tests/data/lexicmap/db.lmi"
                checkm2_db = "$baseDir/tests/data/TestCheckm2DB.dmnd"
                skip_gambit = true


                max_memory = "2.GB"
                max_cpus = 1
            }
        }

        then {
                assert workflow.success
                assert path("$outputDir").exists()
            }
    }
}
